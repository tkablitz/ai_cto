#!/bin/sh
#
# Pre-push gate for a PUBLIC repository.
#
# A push here is irreversible publication: within minutes the blobs are forked,
# cached and indexed, and deleting a file in a later commit does not unpublish
# it. CI cannot help — GitHub Actions runs *after* the push, by which time a
# leaked name is already public. That is why these particular checks are local
# and run before the push, not in a workflow.
#
# Activate once per clone (hooks are not cloned, by design):
#
#     git config core.hooksPath .githooks
#
# `git push --no-verify` bypasses this. That is git's behaviour and cannot be
# prevented from here; it is why the recoverable checks are duplicated in CI
# when CI exists.

set -u

fail=0
say()  { printf '%s\n' "$*" >&2; }
flag() { say "  BLOCKED  $*"; fail=1; }

git_dir=$(git rev-parse --git-dir)
patterns="$git_dir/leak-patterns"

say ""
say "pre-push: checking what this push would publish"

# ---------------------------------------------------------------------------
# 0. The pattern list must exist.
#
# A check that cannot run must fail, never pass quietly. If this file is
# missing, the name scan below would find nothing and look identical to a
# clean result — the vacuous pass described in §2.2 of the guide.
# ---------------------------------------------------------------------------
if [ ! -s "$patterns" ]; then
  say ""
  say "  BLOCKED  no leak-pattern list at:"
  say "           $patterns"
  say ""
  say "  Without it the name scan cannot run, and a check that cannot run must"
  say "  not report success. Create it with the real names that must never"
  say "  appear here — one extended-regex pattern per line, matched"
  say "  case-insensitively:"
  say ""
  say "      acme-corp"
  say "      some-product-name"
  say "      firstname-lastname"
  say ""
  say "  It lives inside .git/ so it is never committed and never published."
  say ""
  exit 1
fi

# Strip blank lines and comments before use. A blank line in a -f pattern file
# is an EMPTY REGEX, which matches every line of every file — the hook would
# block every push and the list would look perfectly reasonable.
effective=$(mktemp) || exit 1
trap 'rm -f "$effective"' EXIT
grep -v -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$patterns" > "$effective"

if [ ! -s "$effective" ]; then
  say ""
  say "  BLOCKED  $patterns contains no usable patterns"
  say "           (only blank lines and comments)"
  say ""
  exit 1
fi

# ---------------------------------------------------------------------------
# Work out which commits this push would actually publish, per ref.
# ---------------------------------------------------------------------------
commits=""
base=""
tip=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;          # a real sha
    *) continue ;;      # all zeros: branch deletion, nothing published
  esac

  case "$remote_sha" in
    *[!0]*) range=$(git rev-list "$remote_sha..$local_sha"); b="$remote_sha" ;;
    *)      range=$(git rev-list "$local_sha" --not --remotes)
            oldest=$(printf '%s\n' $range | grep . | tail -1)
            b=$(git rev-parse "$oldest^" 2>/dev/null || true)
            ;;
  esac

  # Keep the first base/tip seen. Pushes here are single-ref in practice; if a
  # multi-ref push ever happens the net-diff check below simply covers one of
  # them, which is why the per-commit checks above are the primary gate.
  [ -n "$base" ] || base="$b"
  [ -n "$tip" ] || tip="$local_sha"

  commits="$commits $range"
done

commits=$(printf '%s\n' $commits | sort -u)

if [ -z "$commits" ]; then
  say "  nothing new to publish"
  exit 0
fi

n=$(printf '%s\n' "$commits" | grep -c .)
say "  $n commit(s) to scan"

# ---------------------------------------------------------------------------
# 1. Names and local paths, across EVERY tree being published.
#
# Not just the working tree, and not just the diff: a file added in one commit
# and deleted in the next is still published if both commits are pushed, and
# `git show <sha>:<path>` retrieves it forever.
# ---------------------------------------------------------------------------
for c in $commits; do
  short=$(git rev-parse --short "$c")

  if hits=$(git grep -I -n -i -E -f "$effective" "$c" -- 2>/dev/null); then
    flag "excluded name in $short:"
    printf '%s\n' "$hits" | sed 's/^/           /' >&2
  fi

  # A real path carries a real username segment. The rules file legitimately
  # documents the placeholder form (`C:\Users\...`), so requiring an
  # alphanumeric after the separator keeps the rule's own statement of itself
  # from blocking every push forever. Verified: without this the hook fails
  # closed on CLAUDE.md and can never be satisfied.
  if hits=$(git grep -I -n -E \
              -e 'C:\\Users\\[A-Za-z0-9]' \
              -e '/home/[a-z][a-z0-9_-]*/' \
              -e '/Users/[A-Za-z0-9][A-Za-z0-9_-]*/' \
              "$c" -- 2>/dev/null); then
    flag "local filesystem path in $short:"
    printf '%s\n' "$hits" | sed 's/^/           /' >&2
  fi
done

# ---------------------------------------------------------------------------
# 2. Commit metadata. Author and committer email are published too, and are
#    not removable without rewriting history the remote already holds.
#
#    EXACT addresses, never a domain suffix. This check used to accept
#    `*@qednet.com`, which accepts every local part under the domain — so a
#    channel named after a client organization passed every check here while
#    the name scan above was blocking that same string in file content. Not
#    hypothetical: one commit reachable from main carries such an address,
#    published by a channel following the documented ephemeral-clone procedure
#    verbatim. Left in place deliberately — rewriting cannot unpublish it.
#
#    Adding a channel means adding its address to this list, in a commit, in a
#    tracked file. That is the point rather than a chore: an organization-derived
#    address cannot be added without the name appearing where check 1 blocks it.
#    The two checks reinforce each other instead of overlapping.
#
#    Every address here is already in this repository's published history, so
#    listing them discloses nothing a `git log` would not.
# ---------------------------------------------------------------------------
identities=$(cat <<'EOF'
tkablitz@gmail.com
tck@qednet.com
tck+aicto@qednet.com
noreply@github.com
EOF
)

# No blank lines in that list, and an empty address is refused rather than
# tested: `grep -xF ''` matches a blank line, so a blank entry plus an empty
# %ae would be a silent PASS — the same defect this hook already fixed once in
# the leak-pattern list, one check over.
for c in $commits; do
  short=$(git rev-parse --short "$c")
  for addr in $(git log -1 --format='%ae%n%ce' "$c" | sort -u); do
    [ -n "$addr" ] || { flag "empty author/committer address in $short"; continue; }

    printf '%s\n' "$identities" | grep -qxF "$addr" && continue

    flag "unexpected identity in $short: $addr"
    case "$addr" in
      *+*@*)
        say  "           this is channel-shaped, and its channel is not on the list."
        say  "           If the part after '+' names a client, employer or organization,"
        say  "           DO NOT add it — that name would be published into commit metadata,"
        say  "           which no later commit can remove. Hand the change to the prime"
        say  "           channel and let it land under an identity that names nobody."
        ;;
      *)
        say  "           add it to \$identities in .githooks/pre-push if it is intended"
        ;;
    esac
  done
done

# ---------------------------------------------------------------------------
# 3. Licensing, checked against the tip being pushed. An unlicensed file is
#    unlicensed by default, which is the one state nobody can act on.
#
#    `tip` is the ref's actual head, captured during range computation above.
#    It used to be recomputed here as `head -1` of $commits — but $commits is
#    sort -u'd, so that was the lexically smallest SHA rather than the tip.
#    Correct for a single-commit push, which is why it survived; wrong for
#    every other, and it silently made these checks inspect an arbitrary
#    commit's tree.
# ---------------------------------------------------------------------------
for f in $(git ls-tree -r --name-only "$tip" | grep -v '^LICENSE$'); do
  git show "$tip:LICENSE" 2>/dev/null | grep -qF "$f" \
    || flag "not named in LICENSE: $f"
done

for f in $(git ls-tree -r --name-only "$tip" \
           | grep -E '^(starter-CLAUDE\.md|templates/.*\.md)$'); do
  notice=$(git show "$tip:$f" | grep SPDX || true)
  if [ -z "$notice" ]; then
    flag "no SPDX notice: $f"
  elif ! printf '%s' "$notice" | grep -qE 'rev [0-9]{4}-[0-9]{2}-[0-9]{2}'; then
    # Checking only for the string "SPDX" let a template ship with a bare
    # notice and no rev at all. Check 4 below then had no stamp to require
    # moving, so that file was permanently exempt from the staleness gate
    # every other copyable file is subject to — and the exemption looked
    # exactly like a pass. Measured: it happened, one commit after the
    # template was added.
    flag "SPDX notice carries no 'rev YYYY-MM-DD': $f"
    say  "           without a rev there is no stamp for the staleness check to require moving"
  fi
done

# ---------------------------------------------------------------------------
# 4. A rev stamp must move when the file it stamps moves.
#
# The README tells readers to copy these files out. Their only way to tell a
# stale copy from a current one is the `rev` date in the notice, and a stamp
# maintained by hand is a copy of state that lives elsewhere — the exact defect
# §4.4 warns about. So it is enforced rather than remembered.
#
# The test is CO-MOVEMENT across the whole push, not per commit: a series that
# edits content in one commit and bumps the stamp in the next is correct, and a
# per-commit check would fail it. A gate that fires on a healthy path is worse
# than no gate — §1.2.
# ---------------------------------------------------------------------------
if [ -n "$base" ]; then
  for f in $(git diff --name-only "$base..$tip" -- starter-CLAUDE.md 'templates/*.md' 2>/dev/null); do
    # A file added in this push has no prior stamp to move; the SPDX check above
    # already requires it to carry one.
    git cat-file -e "$base:$f" 2>/dev/null || continue

    if ! git diff "$base..$tip" -- "$f" | grep -q '^[+-].*SPDX-License-Identifier'; then
      flag "content changed without a rev bump: $f"
      say  "           readers cannot tell their copy is stale — update the rev date in its notice"
    fi
  done
fi

# ---------------------------------------------------------------------------
say ""
if [ "$fail" -ne 0 ]; then
  say "  push refused. Nothing has been published."
  say ""
  exit 1
fi

say "  clean — publishing"
say ""
exit 0
